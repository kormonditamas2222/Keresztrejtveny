<Window x:Class="KeresztrejtvenyGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KeresztrejtvenyGUI"
        mc:Ignorable="d"
        Title="Keresztrejtvény készítő" Height="450" Width="400">
    <Canvas>
        <Label Content="Keresztrejtvény mérete: [sor x oszlop]"/>
        <ComboBox x:Name="cbSor" Canvas.Left="220" Canvas.Top="5"/>
        <ComboBox x:Name="cbOszlop" Canvas.Left="260" Canvas.Top="5"/>
        <Button x:Name="btnLetrehozas" Content="Keresztrejtvény létrehozása" Canvas.Left="5" Canvas.Top="30" Click="btnLetrehozas_Click"/>
        <Button x:Name="btnMentes" Content="Keresztrejtvény mentése" Canvas.Left="170" Canvas.Top="30"/>
        <ComboBox x:Name="cbIndex" Canvas.Left="320" Canvas.Top="30"/>
    </Canvas>
</Window>
